{
  "name": "coelhinho-craft-pintar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "description": "Peaceful block game for painting, building, and playing with a bunny.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "session:report": "node scripts/session-report.cjs"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
